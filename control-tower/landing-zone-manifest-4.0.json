{
  "accessManagement": {
    "enabled": true
  },
  "backup": {
    "enabled": true,
    "configurations": {
      "backupAdmin": {
        "accountId": "${backup_admin_account_id}"
      },
      "centralBackup": {
        "accountId": "${central_backup_account_id}"
      },
      "kmsKeyArn": "${backup_kms_key_arn}"
    }
  },
  "centralizedLogging": {
    "accountId": "${centralized_logging_account_id}",
    "enabled": true,            
    "configurations": {
      "accessLoggingBucket": {
        "retentionDays": 365
      },
      "loggingBucket": {
        "retentionDays": 365
      },
      "kmsKeyArn": "${centralized_logging_kms_key_arn}"
    }
  },
  "config": {
    "accountId": "${config_account_id}",
    "enabled": true,            
    "configurations": {
      "accessLoggingBucket": {
        "retentionDays": 365
      },
      "loggingBucket": {
        "retentionDays": 365
      },
      "kmsKeyArn": "${config_kms_key_arn}"
    }
  },
  "governedRegions": ${governed_regions},
  "securityRoles": {
    "enabled": true,
    "accountId": "${security_roles_account_id}"
  }
}
