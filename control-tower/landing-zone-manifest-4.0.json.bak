{
  "accessManagement": {
    "enabled": true
  },
  "backup": {
    "enabled": true,
    "configurations": {
      "backupAdmin": {
        "accountId": "${backup_admin_account_id}"
      },
      "centralBackup": {
        "accountId": "${central_backup_account_id}"
      },
      "kmsKeyArn": "arn:aws:kms:region:account-id:key/key-id"
      /*
      "backupPlan": {
        "centralVaultRetentionDays": 0,
        "localVaultRetentionDays": 0,
        "scheduleExpression": "1",
        "selectionTag": {
          "key": "1",
          "value": "1"
        }
      }
      */
    }
  },
  "centralizedLogging": {
    "accountId": "${centralized_logging_account_id}",
    "enabled": true,            
    "configurations": {
      "accessLoggingBucket": {
        /*"bucketArn": "bucketArn",*/
        "retentionDays": 365
      },
      "loggingBucket": {
        /*"bucketArn": "bucketArn",*/
        "retentionDays": 365
      },
      "kmsKeyArn": "arn:aws:kms:region:account-id:key/key-id"
      /*"bucketRegion": "us-east-1"*/
    }
  },
  "config": {
    "accountId": "${config_account_id}",
    "enabled": true,            
    "configurations": {
      "accessLoggingBucket": {
        /*"bucketArn": "bucketArn",*/
        "retentionDays": 365
      },
      "loggingBucket": {
        /*"bucketArn": "bucketArn",*/
        "retentionDays": 365
      },
      "kmsKeyArn": "arn:aws:kms:region:account-id:key/key-id"
    }
  },
  "governedRegions": [            
    "us-east-1"
  ],
  "securityRoles": {
    "enabled": true,            
    "accountId": "${security_roles_account_id}"
  }
}
