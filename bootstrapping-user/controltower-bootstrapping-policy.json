{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowBootstrapperToManageRequiredRoles",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:GetRole",
				"iam:ListRolePolicies",
				"iam:ListAttachedRolePolicies",
				"iam:ListInstanceProfilesForRole",
				"iam:DeleteRole",
				"iam:AttachRolePolicy",
				"iam:PutRolePolicy",
				"iam:GetRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:TagRole"
			],
			"Resource": [
				"arn:${current_partition}:iam::*:role/service-role/AWSControlTower*"
			]
		},
		{
			"Sid": "AllowBootstrapperToManageKMS",
			"Effect": "Allow",
			"Action": [
				"kms:TagResource"
			],
			"Resource": [
				"arn:${current_partition}:kms:*:${current_account_id}:key/*"
			]
		},
		{
			"Sid": "AllowBootstrapperToManageKMS2",
			"Effect": "Allow",
			"Action": [
				"kms:CreateKey",
				"kms:ListAliases"
			],
			"Resource": [
				"*"
			]
		},
		{
			"Sid": "AllowBootstrapperToManageKMS3",
			"Effect": "Allow",
			"Action": "iam:CreateServiceLinkedRole",
			"Resource": "arn:${current_partition}:iam::*:role/aws-service-role/mrk.kms.amazonaws.com/*",
			"Condition": {
				"StringLike": {
					"iam:AWSServiceName": "mrk.kms.amazonaws.com"
				}
			}
		},
		{
			"Sid": "AllowBootstrapperToManageKMS4",
			"Effect": "Allow",
			"Action": [
				"kms:EnableKeyRotation",
				"kms:DescribeKey",
				"kms:GetKeyPolicy",
				"kms:GetKeyRotationStatus",
				"kms:ListResourceTags",
				"kms:CreateAlias",
				"kms:DeleteAlias"
			],
			"Resource": [
				"arn:${current_partition}:kms:us-east-1:${current_account_id}:key/*",
				"arn:${current_partition}:kms:us-east-1:${current_account_id}:alias/*"
			]
		}
    ]
}
