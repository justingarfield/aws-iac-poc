{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowBootstrapperToChangePassword",
			"Effect": "Allow",
			"Action": [
				"iam:ChangePassword"
			],
			"Resource": [
				"${foundational_bootstrapper_arn}"
			]
		},
		{
			"Sid": "AllowBasicIAMLookups",
			"Effect": "Allow",
			"Action": [
				"iam:GetGroup",
				"iam:GetPolicy",
				"iam:ListVirtualMFADevices"
			],
			"Resource": [
				"arn:${current_partition}:iam::${current_account_id}:user/bootstrapper/*",
				"arn:${current_partition}:iam::${current_account_id}:mfa/",
				"arn:${current_partition}:iam::${current_account_id}:policy/bootstrapper/*"
			]
		}
	]
}
