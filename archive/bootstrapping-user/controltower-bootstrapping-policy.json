{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowBootstrapperToManageRequiredRoles",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:GetRole",
				"iam:ListRolePolicies",
				"iam:ListAttachedRolePolicies",
				"iam:ListInstanceProfilesForRole",
				"iam:DeleteRole",
				"iam:AttachRolePolicy",
				"iam:PutRolePolicy",
				"iam:GetRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:TagRole",
				"iam:DetachRolePolicy"
			],
			"Resource": [
				"arn:${current_partition}:iam::*:role/service-role/AWSControlTower*"
			]
		},
		{
			"Sid": "AllowBootstrapperToCreateRoleInOtherAccounts",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole"
			],
			"Resource": [
				"arn:${current_partition}:iam::*:role/*"
			]
		},
		{
			"Sid": "AllowBootstrapperToManageKMS",
			"Effect": "Allow",
			"Action": [
				"kms:TagResource"
			],
			"Resource": [
				"arn:${current_partition}:kms:*:${current_account_id}:key/*"
			]
		},
		{
			"Sid": "AllowBootstrapperToManageKMS2",
			"Effect": "Allow",
			"Action": [
				"kms:CreateKey",
				"kms:ListAliases"
			],
			"Resource": [
				"*"
			]
		},
		{
			"Sid": "AllowBootstrapperToManageKMS3",
			"Effect": "Allow",
			"Action": "iam:CreateServiceLinkedRole",
			"Resource": "arn:${current_partition}:iam::*:role/aws-service-role/mrk.kms.amazonaws.com/*",
			"Condition": {
				"StringLike": {
					"iam:AWSServiceName": "mrk.kms.amazonaws.com"
				}
			}
		},
		{
			"Sid": "AllowBootstrapperToManageKMS4",
			"Effect": "Allow",
			"Action": [
				"kms:EnableKeyRotation",
				"kms:DescribeKey",
				"kms:GetKeyPolicy",
				"kms:GetKeyRotationStatus",
				"kms:ListResourceTags",
				"kms:CreateAlias",
				"kms:DeleteAlias",
				"kms:ScheduleKeyDeletion",
				"kms:UpdateAlias",
				"kms:PutKeyPolicy"
			],
			"Resource": [
				"arn:${current_partition}:kms:us-east-1:${current_account_id}:key/*",
				"arn:${current_partition}:kms:us-east-1:${current_account_id}:alias/*"
			]
		},
		{
			"Sid": "AllowBootstrapperToProvisionLandingZoneWildcard",
			"Effect": "Allow",
			"Action": [
				"controltower:TagResource",
				"controltower:CreateLandingZone",
				"controltower:GetLandingZoneOperation",
				"controltower:UpdateLandingZone",
				"organizations:EnableAWSServiceAccess"
			],
			"Resource": [
				"*"
			]
		},
		{
			"Sid": "AllowBootstrapperToProvisionLandingZoneSpecific",
			"Effect": "Allow",
			"Action": [
				"controltower:GetLandingZoneOperation",
				"controltower:GetLandingZone",
				"controltower:ListTagsForResource"
			],
			"Resource": [
				"arn:${current_partition}:controltower:us-east-1:${current_account_id}:landingzone/*"
			]
		},
		{
			"Sid": "AllowBootstrapperToProvisionLandingZoneSpecific2",
			"Effect": "Allow",
			"Action": [
				"organizations:EnablePolicyType"
			],
			"Resource": [
				"arn:${current_partition}:organizations::${current_account_id}:root/*/*"
			]
		},
		{
			"Sid": "AllowBootstrapperToProvisionIAMIdentityCenter",
			"Effect": "Allow",
			"Action": [
				"sso:ListInstances",
				"identitystore:CreateUser",
				"identitystore:CreateGroup",
				"identitystore:DescribeUser",
				"identitystore:DescribeGroup",
				"identitystore:DeleteUser",
				"identitystore:DeleteGroup",
				"identitystore:CreateGroupMembership",
				"identitystore:DescribeGroupMembership",
				"identitystore:DeleteGroupMembership",
				"sso:TagResource",
				"sso:CreatePermissionSet",
				"sso:DescribePermissionSet",
				"sso:ListTagsForResource",
				"sso:DeletePermissionSet",
				"sso:ListManagedPoliciesInPermissionSet",
				"sso:AttachManagedPolicyToPermissionSet",
				"sso:ProvisionPermissionSet",
				"sso:DetachManagedPolicyFromPermissionSet",
				"sso:DescribePermissionSetProvisioningStatus",
				"sso:ListAccountAssignments",
				"sso:CreateAccountAssignment",
				"sso:DescribeAccountAssignmentCreationStatus"
			],
			"Resource": [
				"arn:${current_partition}:sso:::account/*",
				"arn:${current_partition}:sso:::instance/*",
				"arn:${current_partition}:sso:::permissionSet/ssoins-*",
				"arn:${current_partition}:identitystore::${current_account_id}:identitystore/d-*",
				"arn:${current_partition}:identitystore:::user/*",
				"arn:${current_partition}:identitystore:::group/*",
				"arn:${current_partition}:identitystore:::membership/*"
			]
		}
	]
}
